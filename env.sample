# Root-level compose settings. Copy to .env and adjust as needed:
#   cp env.sample .env && nano .env
# Actual secrets (Mongo URI, Azure app credentials, admin creds, etc.)
# still live in backend/.env (copy from backend/env.sample and nano that too).

# Path segment the whole app is served under (no leading/trailing slash).
BASE_PATH_NAME=listing-ccd

# Port the single container listens on (used directly via network_mode: host).
PORT=6026

# Frontend build-time var (baked into the Vite build). Leave empty so the
# frontend calls the API on the same origin/port it was served from.
VITE_API_BASE_URI=
